{
  "name": "@kew/dashboard-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Kew dashboard UI as a reusable library. createKewDashboard() returns the full BullMQ dashboard (shell, routes, features, design tokens). Consumed by the OSS app and (Fase 2) the cloud web app.",
  "license": "FSL-1.1-ALv2",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.tsx",
    "./extensions": "./src/extensions.tsx",
    "./styles.css": "./src/index.css",
    "./theme.css": "./src/theme.css"
  },
  "types": "./src/index.tsx",
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.5",
    "@fontsource-variable/geist-mono": "^5.2.5",
    "@kew/core": "workspace:*",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-router": "^1.92.3",
    "@tanstack/react-table": "^8.20.6",
    "@tanstack/react-virtual": "^3.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cron-parser": "^5.5.0",
    "cronstrue": "^3.14.0",
    "lucide-react": "^0.469.0",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2"
  }
}
