# Kew configuration. Copy to .env and adjust. Secrets live here at runtime,
# never in the repo: .env is gitignored; this .env.example is the documented template.

# --- Redis (server only; never sent to the browser) ---
# Full connection string, including password / TLS (rediss://) / ACL user if any.
REDIS_URL=redis://localhost:6379
# Key prefix BullMQ uses.
BULLMQ_PREFIX=bull

# --- Server ---
# Port the API (and embedded SPA in production) listens on.
PORT=3000
# Bind address. Default 127.0.0.1 means localhost only (safe by default).
# Set 0.0.0.0 to expose on the network or inside Docker; then also set KEW_AUTH_TOKEN.
HOST=127.0.0.1
# Set to 1 to forbid every mutation (pause, retry, remove, scheduler edits, ...).
READ_ONLY=0

# --- Auth: single shared secret (the whole OSS auth story) ---
# Set a value to require login. Empty = no auth, fine for localhost-only use.
KEW_AUTH_TOKEN=
# Optional login email/username. When set, login requires this AND KEW_AUTH_TOKEN
# (an email + password form). When empty, login is password-only.
KEW_AUTH_USER=
# Optional HMAC key for the session cookie. Empty = derived from KEW_AUTH_TOKEN,
# so sessions survive restarts and rotating the token logs everyone out.
KEW_SESSION_SECRET=

# --- Auth: bring your own SSO via a reverse proxy (oauth2-proxy, Cloudflare Access, ...) ---
# Set to 1 to trust an upstream auth proxy instead of Kew's own login.
KEW_TRUST_PROXY_AUTH=
# Header the proxy sets with the authenticated user.
KEW_PROXY_USER_HEADER=x-forwarded-user
# Trusted reverse-proxy hops for login rate limiting. 0 (default) = key the limiter
# on the socket peer and ignore X-Forwarded-For. When a proxy is trusted (this or
# KEW_TRUST_PROXY_AUTH set), the client IP is taken from the trusted XFF hop.
KEW_TRUSTED_PROXY_HOPS=0

# --- Dashboard dev only ---
# Vite dev server proxies /api to this target.
KEW_API_TARGET=http://localhost:3000
