# Kew configuration. Copy to .env and adjust. Secrets live here at runtime,
# never in the repo: .env is gitignored; this .env.example is the documented template.

# --- Redis (server only; never sent to the browser) ---
# Full connection string, including password / TLS (rediss://) / ACL user if any.
REDIS_URL=redis://localhost:6379
# Key prefix BullMQ uses.
BULLMQ_PREFIX=bull

# --- Server ---
# Port the API (and embedded SPA in production) listens on.
PORT=5399
# Bind address. Default 127.0.0.1 means localhost only (safe by default).
# Set 0.0.0.0 to expose on the network or inside Docker; then also set KEW_AUTH_PASSWORD.
HOST=127.0.0.1
# Set to 1 to forbid every mutation (pause, retry, remove, scheduler edits, ...).
READ_ONLY=0

# --- Auth: one shared login (the whole OSS auth story) ---
# The login password. At least 8 characters. Empty = no auth (fine for localhost only).
KEW_AUTH_PASSWORD=
# Optional email for the login. When set, the form is email + password (this email plus
# KEW_AUTH_PASSWORD); must be a valid email. When empty, login is password-only.
KEW_AUTH_EMAIL=
# Optional HMAC key for the session cookie. Empty = derived from KEW_AUTH_PASSWORD,
# so sessions survive restarts and rotating the password logs everyone out.
KEW_SESSION_SECRET=

# --- Auth: bring your own SSO via a reverse proxy (oauth2-proxy, Cloudflare Access, ...) ---
# Set to 1 to trust an upstream auth proxy instead of Kew's own login.
KEW_TRUST_PROXY_AUTH=
# Header the proxy sets with the authenticated user.
KEW_PROXY_USER_HEADER=x-forwarded-user
# Trusted reverse-proxy hops for login rate limiting. 0 (default) = key the limiter
# on the socket peer and ignore X-Forwarded-For. When a proxy is trusted (this or
# KEW_TRUST_PROXY_AUTH set), the client IP is taken from the trusted XFF hop.
KEW_TRUSTED_PROXY_HOPS=0

# --- Job retention / history (opt-in) ---
# Kew is read-through over Redis: once your queues use removeOnComplete/removeOnFail,
# finished jobs vanish and there is no history. Turn retention on to have Kew observe
# jobs via a BullMQ listener and keep a durable local record (SQLite), independent of
# your removeOnComplete settings. Off by default (zero overhead).
KEW_RETENTION=
# Where the SQLite history file lives. In Docker, mount a volume at this path so the
# history survives container restarts.
KEW_RETENTION_DB_PATH=./kew-retention.db
# Drop records older than this many days (0 = no age limit).
KEW_RETENTION_MAX_AGE_DAYS=30
# Hard cap on total retained rows, keeping the newest (0 = no row limit).
KEW_RETENTION_MAX_ROWS=0

# --- Updates ---
# Kew shows the running version (read from package.json) in the sidebar and checks
# GitHub once an hour for a newer release, surfacing a subtle "update available" link.
# The check is server-side, cached, and fail-soft. Set to 0 to disable it entirely.
KEW_UPDATE_CHECK=1

# --- Dashboard dev only ---
# Vite dev server proxies /api to this target.
KEW_API_TARGET=http://localhost:5399
