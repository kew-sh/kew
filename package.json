{
  "name": "kew",
  "private": true,
  "version": "0.0.0",
  "description": "Open-source dashboard for BullMQ queues and crons (codename).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '@kew/dashboard' dev",
    "server": "bun --filter '@kew/server' start",
    "seed": "bun --filter '@kew/server' seed",
    "build": "bun --filter '@kew/dashboard' build",
    "typecheck": "bun --filter '@kew/dashboard' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16"
  }
}
