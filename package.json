{
  "name": "kew",
  "private": true,
  "version": "0.0.0",
  "description": "Source-available dashboard for BullMQ queues and crons.",
  "license": "FSL-1.1-ALv2",
  "author": "Pedro Henrique Gomes Rodrigues Marques",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '@kew/dashboard' dev",
    "server": "bun --filter '@kew/server' start",
    "seed": "bun --filter '@kew/server' seed",
    "build": "bun --filter '@kew/dashboard' build",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:licenses": "bun scripts/check-licenses.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16"
  }
}
